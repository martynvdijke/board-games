# Identity
APP_NAME=The Shelf
ENV=development
PORT=6290
BASE_URL=http://localhost:6290
DATABASE_PATH=./data/boardgames.db
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL=720h
TZ=UTC

# OpenID Connect (Authorization Code + PKCE)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=the-shelf
OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URL=https://shelf.example.com/auth/callback
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# BoardGameGeek (read-only XML API2)
BGG_BASE_URL=https://boardgamegeek.com/xmlapi2
BGG_USER_AGENT=TheShelf/1.0 (you@example.com)
BGG_REQUESTS_PER_SECOND=1
BGG_REFRESH_DAYS=30
BGG_SYNC_INTERVAL=6h

# Reverse proxy: only these addresses may set forwarded headers
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Operations
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boardgames
UMAMI_URL=
UMAMI_WEBSITE_ID=
LOG_LEVEL=info
VERSION=dev

# Local/e2e only: bypass OIDC with a fixed user. Never enable in production.
DEV_FAKE_AUTH=false
DEV_FAKE_EMAIL=owner@example.com
DEV_FAKE_NAME=Shelf Owner
