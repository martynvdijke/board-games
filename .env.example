# Identity
APP_NAME=The Shelf
ENV=development
PORT=6270
BASE_URL=http://localhost:6270
DATABASE_PATH=./data/boardgames.db
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_TTL=720h
TZ=UTC

# OpenID Connect (Authorization Code + PKCE)
OIDC_ISSUER=https://auth.example.com
OIDC_CLIENT_ID=the-shelf
OIDC_CLIENT_SECRET=replace-me
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# OIDC_REDIRECT_URL=https://shelf.example.com/auth/callback
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# BoardGameGeek (read-only XML API2)
# BGG requires an approved application token for every XML API request.
# Create one at https://boardgamegeek.com/applications (approval can take a week),
# or leave this empty and save the token in Settings as an admin.
BGG_BASE_URL=https://boardgamegeek.com/xmlapi2
BGG_USER_AGENT=TheShelf/1.0 (you@example.com)
BGG_API_TOKEN=
# BGG_API_TOKEN_FILE=/run/secrets/bgg-api-token
BGG_REQUESTS_PER_SECOND=1
BGG_REFRESH_DAYS=30
BGG_SYNC_INTERVAL=6h

# Display currency for collection value (ISO 4217). This is a label only:
# prices are stored in minor units and are never converted between currencies.
SHOP_CURRENCY=GBP

# Telegram notifications (optional). Leave both empty to disable. Create a bot
# with @BotFather, then start a chat with it and use its numeric chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Loan reminders (optional). Nothing is sent unless REMINDERS_ENABLED=true and a
# notifier (Telegram) is configured. LOAN_REMINDER_DAYS is the minimum wait
# between reminders for the same loan; LOAN_IDLE_REMINDER_DAYS is the first
# nudge for loans with no due date.
REMINDERS_ENABLED=false
LOAN_REMINDER_DAYS=14
LOAN_IDLE_REMINDER_DAYS=30

# Public Play Store review demo. Leave disabled on private instances.
DEMO_USER_ENABLED=false
DEMO_USER_EMAIL=demo@theshelf.local
DEMO_USER_NAME=Shelf Demo
# Required when enabled in production; must start with bg_.
DEMO_USER_TOKEN=

# Reverse proxy: only these addresses may set forwarded headers
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Operations
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=boardgames
UMAMI_URL=
UMAMI_WEBSITE_ID=

# Public legal pages. Leave the name empty to use "The operator of this <app> instance".
LEGAL_CONTROLLER_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_ADDRESS=
LEGAL_HOSTING_REGION=the European Union

LOG_LEVEL=info
VERSION=dev

# Local/e2e only: bypass OIDC with a fixed user. Never enable in production.
DEV_FAKE_AUTH=false
DEV_FAKE_EMAIL=owner@example.com
DEV_FAKE_NAME=Shelf Owner
